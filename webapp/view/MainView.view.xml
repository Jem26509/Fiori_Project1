<mvc:View controllerName="jemnamespace.jemproject1.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
        <content>
            <Panel id="pnlSelecction" headerText="{i18n>selectionScreen}">
                <Label id="lblShipName" labelFor="shipName" text="{i18n>shipName}" class="sapUiSmallMargin" />
                <Input id="shipName" width="200px" class="sapUiSmallMarginEnd" />
                <Label id="lblcountry" labelFor="slCountry" text="{i18n>country}" class="sapUiSmallMargin"/>
                <Select id="slCountry" width="200px"
                                       selectedKey="{selectionScreen>/CountryKey}" 
                                       forceSelection="false"
                                       items="{selectionScreen>/Countries}">
                    <items>
                        <core:Item id="100" key="{selectionScreen>key}" text="{selectionScreen>text}"/>
                    </items>
                </Select>
                <Button id="btnAbrir" text="{i18n>btnAbrir}" class="sapUiSmallMarginEnd" />
            </Panel>
            <Text id="txtHola" textAlign="Center" text="Hola, Soy Jairo M."></Text>            
        </content>
    </Page>
</mvc:View>